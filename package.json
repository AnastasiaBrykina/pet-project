		"@commitlint/config-conventional": "^21.2.3",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"browserslist-to-esbuild": "^2.1.1",
		"lefthook": "^2.1.14",
		"sharp": "^0.35.4",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vite-imagetools": "^12.0.1",
